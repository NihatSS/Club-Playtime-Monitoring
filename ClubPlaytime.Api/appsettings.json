{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=club-playtime.db",
    "SqlServer": "Server=(localdb)\\MSSQLLocalDB;Database=ClubPlaytime;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "Monitoring": {
    "CheckIntervalSeconds": 60,
    "TargetGameName": "Racket Rivals",
    "RobloxBaseUrl": "https://www.roblox.com",
    "RequestTimeoutSeconds": 20,
    "EnableDiscordNotifications": false,
    "DiscordWebhookUrl": "",
    "RobloxSecurityCookie": "",
    "AvatarThumbnailUrl": "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds={0}&size=150x150&format=Png&isCircular=false"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
